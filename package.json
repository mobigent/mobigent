{
  "name": "mobigent-repo",
  "version": "0.1.6",
  "description": "Open-source SDK for exposing mobile app intents and capabilities to AI agents.",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:sdk": "npm run build -w @mobigent/core -w @mobigent/providers -w @mobigent/gateway -w @mobigent/backend -w @mobigent/react-native -w create-mobigent-app",
    "typecheck": "npm run build:sdk && npm run typecheck --workspaces --if-present",
    "test": "npm run build:sdk && node --test --import tsx tests/*.test.ts",
    "verify": "npm run typecheck && npm test && npm run bin:smoke && npm run rn-cli:smoke && npm run create-app:smoke && npm run create-app:runtime && npm run pack:check && npm run docs:build",
    "pack:check": "tsx scripts/pack-check.ts",
    "bin:smoke": "npm run build:sdk && tsx scripts/verify-bin-entrypoints.ts",
    "create-app:smoke": "tsx scripts/verify-create-app.ts",
    "create-app:runtime": "npm run build:sdk && tsx scripts/verify-create-app-runtime.ts",
    "rn-cli:smoke": "tsx scripts/verify-rn-cli.ts",
    "verify:ios": "swift test --package-path packages/ios && swift build --package-path examples/ios-expense",
    "verify:android": "gradle -p packages/android test && gradle -p examples/android-expense :app:assembleDebug",
    "docs:start": "npm run start -w @mobigent/docs",
    "docs:build": "npm run build -w @mobigent/docs",
    "starter:new": "npm run build:sdk && node packages/create-app/dist/cli.js --local-packages .",
    "dev:gateway": "npm run build:sdk && tsx packages/gateway/src/server.ts",
    "dev:http": "npm run build:sdk && tsx packages/gateway/src/http-server.ts",
    "dev:mcp": "npm run build:sdk && tsx packages/gateway/src/mcp-server.ts",
    "dev:app": "npm run build:sdk && tsx examples/expense-app/app.ts",
    "demo:app": "npm run build:sdk && tsx examples/expense-app/run-visible-app-demo.ts",
    "demo": "npm run build:sdk && tsx examples/expense-app/run-local-demo.ts",
    "demo:http": "npm run build:sdk && tsx examples/expense-app/run-http-demo.ts",
    "demo:magic": "npm run build:sdk && tsx examples/expense-app/run-flagship-demo.ts",
    "clean": "rm -rf packages/*/dist examples/*/dist dist"
  },
  "keywords": [
    "mobigent",
    "mcp",
    "agents",
    "react-native",
    "mobile",
    "sdk"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}

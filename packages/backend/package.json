{
  "name": "@mobigent/backend",
  "version": "0.1.15",
  "description": "Backend SDK for calling mobile app functions through Mobigent.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mobigent/mobigent",
    "directory": "packages/backend"
  },
  "bugs": {
    "url": "https://github.com/mobigent/mobigent/issues"
  },
  "homepage": "https://mobigent.github.io/mobigent/",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mobigent-backend": "./dist/cli.js",
    "mobigent-mcp": "./dist/mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json; [ -f dist/cli.js ] && chmod +x dist/cli.js || true; [ -f dist/mcp.js ] && chmod +x dist/mcp.js || true",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mobigent/core": "0.1.15",
    "@mobigent/gateway": "0.1.15",
    "@mobigent/providers": "0.1.15"
  },
  "devDependencies": {
    "@types/node": "^25.9.1"
  }
}

{
  "name": "@mobigent/core",
  "version": "0.1.15",
  "description": "Advanced shared protocol and type definitions for Mobigent.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mobigent/mobigent",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/mobigent/mobigent/issues"
  },
  "homepage": "https://mobigent.github.io/mobigent/",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck"
  }
}

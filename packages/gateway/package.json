{
  "name": "@mobigent/gateway",
  "version": "0.1.15",
  "description": "Transport layer for routing agent calls to mobile app functions.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mobigent/mobigent",
    "directory": "packages/gateway"
  },
  "bugs": {
    "url": "https://github.com/mobigent/mobigent/issues"
  },
  "homepage": "https://mobigent.github.io/mobigent/",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mobigent-gateway": "./dist/server.js",
    "mobigent-http": "./dist/http-server.js",
    "mobigent-mcp": "./dist/mcp-server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json; [ -f dist/server.js ] && chmod +x dist/server.js || true; [ -f dist/http-server.js ] && chmod +x dist/http-server.js || true; [ -f dist/mcp-server.js ] && chmod +x dist/mcp-server.js || true",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "dependencies": {
    "@mobigent/core": "0.1.15",
    "@mobigent/providers": "0.1.15",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ws": "^8.18.1"
  }
}

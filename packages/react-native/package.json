{
  "name": "@mobigent/react-native",
  "version": "0.1.12",
  "description": "React Native SDK for exposing app capabilities to AI agents through Mobigent.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mobigent/mobigent",
    "directory": "packages/react-native"
  },
  "bugs": {
    "url": "https://github.com/mobigent/mobigent/issues"
  },
  "homepage": "https://mobigent.github.io/mobigent/",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mobigent-init": "./dist/cli.js",
    "mobigent-expo-init": "./dist/cli.js",
    "mobigent-rn-init": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./simple": {
      "types": "./dist/simple.d.ts",
      "import": "./dist/simple.js"
    },
    "./schema-adapters": {
      "types": "./dist/schemaAdapters.d.ts",
      "import": "./dist/schemaAdapters.js"
    },
    "./platform-actions": {
      "types": "./dist/platformActions.d.ts",
      "import": "./dist/platformActions.js"
    },
    "./expo": {
      "types": "./dist/expo.d.ts",
      "import": "./dist/expo.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "dependencies": {
    "@mobigent/core": "0.1.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/ws": "^8.18.1",
    "react": "^19.2.6",
    "react-native": "^0.85.3"
  },
  "peerDependencies": {
    "react": "^19.2.6",
    "react-native": "^0.85.3"
  }
}
